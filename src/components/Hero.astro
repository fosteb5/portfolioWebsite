---
import { hero, site } from '../content';
import PadLink from './PadLink.astro';
import TraceText from './TraceText.astro';
---

<section class="hero" id="top" data-board="green" data-mark={site.boardMark} data-chip="ESP32">
  <canvas class="board-canvas" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <TraceText as="h1" text={hero.name} class="hero-name await-motion" />
    <div class="hero-foot" data-keepout>
      <div class="hero-copy">
        <p class="hero-lead">{hero.lead}</p>
        <p class="hero-when">{hero.availability}</p>
      </div>
      <div class="hero-cta">
        <PadLink href={hero.primaryCta.href}>{hero.primaryCta.label}</PadLink>
        <PadLink href={hero.secondaryCta.href} variant="ghost">{hero.secondaryCta.label}</PadLink>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: 100dvh;
    overflow: clip;
    background: var(--mask);
  }
  /* Hands the board over to the plain ground of the next section. */
  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 96px;
    background: linear-gradient(transparent, var(--mask));
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 24px;
    width: 100%;
    max-width: 1560px;
    margin-inline: auto;
    padding: calc(var(--nav-h) + 52px) var(--gutter) clamp(24px, 4.4vh, 48px);
  }
  .hero-inner :global(.hero-name) { align-self: center; --trace-size: min(9.6vw, 18.5vh); }

  .hero-foot { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 40px; }
  .hero-copy { max-width: 40rem; }
  .hero-lead { margin: 0; font-size: clamp(1.125rem, 1.75vw, 1.625rem); line-height: 1.3; text-wrap: balance; }
  .hero-when { margin: 0.55rem 0 0; color: var(--silk-dim); font-size: clamp(0.9375rem, 1.1vw, 1.0625rem); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Entrance for the copy. CSS only, so it never waits on JavaScript. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy, .hero-cta { animation: rise 900ms var(--ease-out) 120ms both; }
    .hero-cta { animation-delay: 240ms; }
    @keyframes rise { from { opacity: 0.01; transform: translateY(18px); } }
  }

  /* Matches the board, which turns portrait at the same ratio. */
  @media (max-aspect-ratio: 6/5) {
    .hero-inner { grid-template-rows: auto 1fr; padding-top: calc(var(--nav-h) + 40px); }
    .hero-inner :global(.hero-name) { align-self: start; --trace-size: 15.4vw; }
    .hero-foot { align-self: end; }
  }
  @media (max-width: 760px) {
    .hero-cta { width: 100%; }
    .hero-cta :global(.pad) { flex: 1 1 0; padding-inline: 0.75rem; }
  }
</style>
