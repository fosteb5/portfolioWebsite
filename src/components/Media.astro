---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Media } from '../content';

interface Props {
  media: Media;
  sizes?: string;
  class?: string;
}

const { media, sizes = '(min-width: 1024px) 70vw, 100vw', class: className } = Astro.props;
const { type, src, poster, alt, caption, ratio = '16/9' } = media;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/**/*.{jpg,jpeg,png,webp,avif}');
const key = `/src/assets/${src}`;
const loader = type === 'image' && src ? images[key] : undefined;
if (type === 'image' && src && !loader) {
  throw new Error(`Image not found: ${key}. Check the path in src/content.ts.`);
}
const image = loader ? (await loader()).default : undefined;
const empty = !src;
---

<figure class:list={['media', className]} style={`--ratio:${ratio}`}>
  <div class="media-frame" data-parallax-frame>
    {image && <Picture src={image} formats={['avif', 'webp']} widths={[640, 960, 1280, 1920]} sizes={sizes} alt={alt} loading="lazy" decoding="async" data-parallax />}
    {
      type === 'video' && src && (
        <video controls playsinline preload="none" poster={poster || undefined} aria-label={alt}>
          <source src={src} type="video/mp4" />
        </video>
      )
    }
    {
      empty && (
        <div class="media-empty" role="img" aria-label={`Placeholder for: ${alt}`}>
          <i></i><i></i><i></i><i></i>
          <span class="ref">{type === 'video' ? 'Video to come' : 'Photo to come'}</span>
          {import.meta.env.DEV && <span class="media-todo">TODO: set src in src/content.ts</span>}
        </div>
      )
    }
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .media { margin: 0; }
  .media-frame {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--void);
    --c: 16px;
    clip-path: polygon(var(--c) 0, calc(100% - var(--c)) 0, 100% var(--c), 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, var(--c) 100%, 0 calc(100% - var(--c)), 0 var(--c));
  }
  .media-frame :global(img),
  .media-frame video { display: block; width: 100%; height: 100%; object-fit: cover; }
  figcaption { margin-top: 10px; color: var(--silk-dim); font-size: 0.875rem; line-height: 1.4; }

  .media-empty { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 6px; text-align: center; padding: 16px; }
  .media-empty i { position: absolute; width: 18px; height: 18px; }
  .media-empty i:nth-child(1) { top: 22px; left: 22px; border-top: 1.5px solid var(--silk-dim); border-left: 1.5px solid var(--silk-dim); }
  .media-empty i:nth-child(2) { top: 22px; right: 22px; border-top: 1.5px solid var(--silk-dim); border-right: 1.5px solid var(--silk-dim); }
  .media-empty i:nth-child(3) { bottom: 22px; left: 22px; border-bottom: 1.5px solid var(--silk-dim); border-left: 1.5px solid var(--silk-dim); }
  .media-empty i:nth-child(4) { bottom: 22px; right: 22px; border-bottom: 1.5px solid var(--silk-dim); border-right: 1.5px solid var(--silk-dim); }
  .media-todo { color: #ff8f7a; font-size: 0.8125rem; }
</style>
