---
import { Picture } from 'astro:assets';
import { projects, work } from '../content';
import { BOARDS, boardStyle } from '../lib/boards';
import { projectImage } from '../lib/images';
import Diagram from './Diagram.astro';
import PadLink from './PadLink.astro';
import TraceText from './TraceText.astro';

/* A card shows the project's first photo. Until it has one, the system diagram stands in. */
const pad = (n: number) => String(n).padStart(2, '0');
const cards = await Promise.all(
  projects.map(async (project) => {
    const photo = project.media.find((media) => media.type === 'image' && media.src);
    return { project, photo, image: photo?.src ? await projectImage(photo.src) : undefined };
  }),
);
---

<section class="rail" id="work" aria-labelledby="work-title" data-rail>
  <div class="rail-head wrap">
    <div class="rail-intro">
      <TraceText id="work-title" text={['FEATURED', 'WORK']} class="rail-title" />
      <p>{work.intro}</p>
    </div>
  </div>

  <div class="rail-view" id="work-rail" data-rail-view tabindex="0" role="region" aria-roledescription="carousel" aria-label="Projects. Use the arrow keys to move between them.">
    <div class="rail-track">
      <div class="rail-edge rail-edge-top" aria-hidden="true"></div>
      <div class="rail-edge rail-edge-bottom" aria-hidden="true"></div>
      {
        cards.map(({ project, photo, image }, i) => (
          <>
            {i > 0 && <div class="bites" aria-hidden="true"></div>}
            <article class="module" style={boardStyle(project.board)} data-module aria-roledescription="slide" aria-label={`${i + 1} of ${cards.length}: ${project.name}`}>
              <span class="hole hole-a" aria-hidden="true"></span>
              <span class="hole hole-b" aria-hidden="true"></span>
              <span class="hole hole-c" aria-hidden="true"></span>
              <span class="hole hole-d" aria-hidden="true"></span>

              <div class="module-head">
                <div class="module-title">
                  <TraceText as="h3" text={project.traceName} class="module-name" />
                  <ul class="module-tags">
                    {project.tags.map((tag) => <li class="ref">{tag}</li>)}
                  </ul>
                </div>
                <div class="module-copy">
                  <p class="module-summary">{project.summary}</p>
                  <dl class="module-meta">
                    <div><dt class="ref">Role</dt><dd>{project.role}</dd></div>
                    <div><dt class="ref">When</dt><dd>{project.when}</dd></div>
                  </dl>
                  <div class="module-actions">
                    <PadLink href={`/work/${project.slug}/`} data-via={BOARDS[project.board].mask}>
                      {work.cta}<span class="sr-only">: {project.name}</span>
                    </PadLink>
                    {project.links?.map((link) => (
                      <a class="module-out" href={link.href} target="_blank" rel="noreferrer">
                        {link.label}
                        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4.5 3H9v4.5" /></svg>
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>

              {/* The window repeats the case study link for pointers only, so keyboards and screen readers skip it. */}
              <a class:list={['module-window', image ? 'has-photo' : 'has-diagram']} href={`/work/${project.slug}/`} data-via={BOARDS[project.board].mask} tabindex="-1" aria-hidden="true" draggable="false">
                <div class="module-art" data-module-art>
                  {image && photo ? (
                    <Picture src={image} formats={['avif', 'webp']} widths={[560, 960, 1280, 1600]} sizes="(min-width: 1024px) min(70vw, 1080px), min(84vw, 560px)" alt="" loading="lazy" decoding="async" draggable="false" />
                  ) : (
                    <>
                      <Diagram diagram={project.diagram} title={`System diagram for ${project.name}`} />
                      <div class="module-chip"><i></i><span class="ref">{project.chip}</span><i></i></div>
                    </>
                  )}
                </div>
              </a>
              <span class="module-ref ref" aria-hidden="true">PCB{i + 1}</span>
            </article>
          </>
        ))
      }
    </div>
  </div>

  {/* One bar under the boards: the counter, the arrow pads, and a copper trace with a via for each board. */}
  <div class="rail-bar">
    <p class="rail-count" aria-hidden="true">
      <span class="ref">PCB</span>
      <span class="rail-count-num"><span data-rail-count>01</span><span class="rail-count-of">/{pad(cards.length)}</span></span>
    </p>
    <button class="pad pad-ghost rail-btn rail-prev" type="button" data-rail-step="-1" aria-controls="work-rail" aria-label="Previous project">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
    </button>
    <nav class="rail-nav" aria-label="Choose a project">
    <div class="rail-bus" data-rail-bus>
      <span class="rail-bus-fill" data-rail-fill aria-hidden="true"></span>
      <span class="rail-signal" data-rail-signal aria-hidden="true"></span>
      <ol style={`--boards:${cards.length}`}>
        {cards.map(({ project }, i) => (
          <li>
            <button type="button" data-rail-go={i} aria-controls="work-rail" aria-current={i === 0 ? 'true' : undefined}>
              <i aria-hidden="true"></i>
              <span class="ref">{project.traceName.join(' ')}</span>
              <span class="sr-only">: show {project.name}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
    </nav>
    <button class="pad rail-btn rail-next" type="button" data-rail-step="1" aria-controls="work-rail" aria-label="Next project">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
    </button>
  </div>
  <p class="sr-only" aria-live="polite" data-rail-live></p>
</section>

<style>
  .rail {
    position: relative;
    padding-block: calc(var(--nav-h) + clamp(28px, 4vw, 56px)) clamp(48px, 6vw, 88px);
    background: var(--void);
    --card-w: min(76vw, 1120px);
    /* Tall enough to read, short enough that a whole board and the control bar under it share one screen. */
    --card-h: clamp(400px, calc(100dvh - var(--nav-h) - 210px), 660px);
  }

  .rail-head { margin-bottom: clamp(28px, 3.4vw, 48px); }

  /* The control bar: counter, arrow pads either side of the bus. Everything centres on the bus line, 28px down. */
  /* As wide as a board, so its ends line up with the board in view. */
  .rail-bar { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; align-items: start; gap: 12px 22px; width: var(--card-w); margin: clamp(24px, 2.6vw, 36px) auto 0; }
  .rail-count { display: flex; align-items: baseline; gap: 10px; margin: 13px 8px 0 0; }
  .rail-count-num { font: 700 1.875rem / 1 var(--font-mono); color: var(--trace); font-variant-numeric: tabular-nums; }
  .rail-count-of { color: var(--silk-dim); font-size: 0.5em; font-weight: 400; margin-left: 3px; }
  .rail-btn { width: 56px; min-height: 56px; padding: 0; border: 0; background: none; font: inherit; cursor: pointer; }
  .rail-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* The strip of boards: a native scroller that snaps each board to the centre, with a sliver of each neighbour. */
  .rail-view {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block: 30px;
    outline: none;
  }
  .rail-view::-webkit-scrollbar { display: none; }
  .rail-view:focus-visible { box-shadow: inset 0 0 0 2px var(--trace); }
  .rail-view.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .rail-view.is-dragging * { pointer-events: none; }
  .rail-track { position: relative; display: flex; align-items: stretch; width: max-content; padding-inline: calc((100cqw - var(--card-w)) / 2); }
  .rail-view { container-type: inline-size; }
  @media (hover: hover) and (pointer: fine) {
    .rail-view { cursor: grab; }
  }

  /* Tooling rails along the panel, with fiducials. */
  .rail-edge { position: absolute; left: 0; right: 0; height: 12px; background: radial-gradient(circle, transparent 3.5px, var(--trace) 4px 5.5px, transparent 6px) 40px 0 / 340px 12px repeat-x; opacity: 0.5; }
  .rail-edge-top { top: -22px; }
  .rail-edge-bottom { bottom: -22px; }

  .rail-intro { display: grid; gap: 18px; max-width: 640px; }
  .rail-intro :global(.rail-title) { --trace-size: clamp(2.1rem, 4.6vw, 4.2rem); }
  .rail-intro p { margin: 0; max-width: 26em; font-size: clamp(1.0625rem, 1.4vw, 1.3125rem); line-height: 1.4; color: var(--silk-dim); text-wrap: pretty; }

  /* The navigator: a copper bus with a via per board. Gold fills the trace up to the board in view. */
  .rail-bus { position: relative; --bus-y: 28px; }
  .rail-bus::before { content: ""; position: absolute; left: 0; right: 0; top: calc(var(--bus-y) - 1px); height: 2px; background: color-mix(in srgb, var(--cu) 70%, transparent); }
  .rail-bus-fill { position: absolute; left: 0; top: calc(var(--bus-y) - 1px); width: 100%; height: 2px; background: var(--trace); transform-origin: 0 50%; transform: scaleX(0); transition: transform 520ms var(--ease-out); }
  .rail-signal { position: absolute; left: 0; top: calc(var(--bus-y) - 9px); width: 18px; height: 18px; border-radius: 50%; background: var(--trace); box-shadow: 0 0 0 5px color-mix(in srgb, var(--trace) 22%, transparent), 0 0 18px color-mix(in srgb, var(--trace) 55%, transparent); transform: translateX(-9px); transition: transform 520ms var(--ease-out); pointer-events: none; }
  .rail-bus ol { position: relative; display: grid; grid-template-columns: repeat(var(--boards, 7), minmax(0, 1fr)); margin: 0; padding: 19px 0 0; list-style: none; }
  .rail-bus li { display: flex; justify-content: center; }
  .rail-bus button {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 0 4px 6px;
    border: 0;
    background: none;
    color: var(--silk-dim);
    font: inherit;
    text-align: center;
    cursor: pointer;
  }
  .rail-bus button i { width: 18px; height: 18px; border: 2.5px solid var(--trace); border-radius: 50%; background: var(--void); transition: transform 220ms var(--ease-out); }
  .rail-bus button .ref { color: inherit; font-size: 0.75rem; letter-spacing: 0.04em; transition: color 180ms ease; }
  .rail-bus button[aria-current] { color: var(--silk); }
  .rail-bus button:focus-visible { outline: 2px solid var(--trace); outline-offset: 4px; }

  /* Mouse bites: the breakaway tabs between boards on a panel. */
  .bites { flex: none; width: 30px; background: radial-gradient(circle, var(--mask) 3px, transparent 3.6px) center / 12px 15px repeat-y; opacity: 0.8; }

  /* Sized so a whole board, and a sliver of each neighbour, fits on screen at once. */
  .module {
    position: relative;
    flex: none;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: clamp(20px, 2.2vw, 32px);
    width: var(--card-w);
    height: var(--card-h);
    padding: clamp(40px, 3.4vw, 52px) clamp(32px, 3.8vw, 56px);
    background: var(--mask);
    color: var(--silk);
    scroll-snap-align: center;
    --c: 26px;
    clip-path: polygon(var(--c) 0, calc(100% - var(--c)) 0, 100% var(--c), 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, var(--c) 100%, 0 calc(100% - var(--c)), 0 var(--c));
  }

  .hole { position: absolute; width: 16px; height: 16px; border: 3px solid var(--trace); border-radius: 50%; background: var(--void); }
  .hole-a { top: 18px; left: 34px; }
  .hole-b { top: 18px; right: 34px; }
  .hole-c { bottom: 18px; left: 34px; }
  .hole-d { bottom: 18px; right: 34px; }

  .module-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(24px, 3.4vw, 56px); align-items: start; }
  .module-title { display: grid; gap: 16px; min-width: 0; }
  .module-title :global(.module-name) { --trace-size: clamp(1.6rem, 2.9vw, 2.75rem); }
  .module-tags { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0; padding: 0; list-style: none; }

  .module-copy { display: grid; gap: 14px; min-width: 0; }
  .module-summary { margin: 0; font-size: clamp(1rem, 1.25vw, 1.1875rem); line-height: 1.42; text-wrap: pretty; }
  .module-meta { display: flex; flex-wrap: wrap; gap: 8px 32px; margin: 0; }
  .module-meta dd { margin: 1px 0 0; font-size: 0.9375rem; line-height: 1.3; }
  .module-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 24px; margin-top: 4px; }

  .module-out {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--silk);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--silk) 40%, transparent);
    text-underline-offset: 5px;
    transition: color 180ms ease, text-decoration-color 180ms ease;
  }
  .module-out svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 220ms var(--ease-out); }

  /* A window cut through the mask, showing the photo or the inner-layer schematic. */
  .module-window {
    position: relative;
    display: block;
    min-height: 0;
    overflow: hidden;
    background: var(--void);
    --c: 16px;
    clip-path: polygon(var(--c) 0, calc(100% - var(--c)) 0, 100% var(--c), 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, var(--c) 100%, 0 calc(100% - var(--c)), 0 var(--c));
  }
  .module-window.has-diagram { background: radial-gradient(circle, color-mix(in srgb, var(--cu) 55%, transparent) 1px, transparent 1.6px) 0 0 / 18px 18px, var(--void); }
  /* Wider than the window, so the parallax never shows an edge. */
  .module-art { position: absolute; inset: 0 -32px; display: grid; place-items: center; }
  .has-diagram .module-art { padding: clamp(20px, 2.4vw, 36px) calc(32px + clamp(20px, 2.4vw, 36px)); }
  .module-art :global(.diagram) { width: min(100%, var(--dg-w)); max-height: 100%; }
  .module-art :global(.dg-box) { fill: var(--mask); }
  .module-art :global(picture) { display: contents; }
  .module-art :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale 600ms var(--ease-out); }

  /* Phones only: the project's main chip stands in for a diagram too small to read. */
  .module-chip { display: none; flex-direction: column; align-items: stretch; gap: 0; }
  .module-chip i { height: 9px; margin-inline: 12px; background: repeating-linear-gradient(90deg, var(--trace) 0 6px, transparent 6px 14px); }
  .module-chip span { padding: 18px 30px; background: #111315; outline: 1px solid color-mix(in srgb, var(--silk) 22%, transparent); color: var(--silk); font-size: 1rem; font-weight: 700; letter-spacing: 0.08em; text-align: center; }

  .module-ref { position: absolute; right: 62px; bottom: 16px; }

  @media (hover: hover) and (pointer: fine) {
    .rail-bus button:hover { color: var(--silk); }
    .rail-bus button:hover i { transform: scale(1.25); }
    .module-out:hover { color: var(--trace); text-decoration-color: currentColor; }
    .module-out:hover svg { transform: translate(2px, -2px); }
    .module-window:hover :global(img) { scale: 1.03; }
  }

  @media (max-width: 1023px) {
    .rail { --card-w: min(84vw, 560px); }
    /* Phones: the gold signal shows the place, so the counter makes way for the board and buttons to share the screen. */
    .rail-bar { grid-template-columns: auto minmax(0, 1fr) auto; gap: 14px; margin-top: 14px; }
    .rail-count { display: none; }
    .rail-view { padding-block: 18px; }
    .rail-edge-top { top: -16px; }
    .rail-edge-bottom { bottom: -16px; }
    /* Too narrow for names under every via; the counter carries the place instead. */
    .rail-bus button .ref { display: none; }
    .module { width: min(84vw, 560px); height: auto; grid-template-rows: auto; align-content: start; padding: 32px 22px 30px; gap: 16px; --c: 18px; }
    .module-head { grid-template-columns: 1fr; gap: 18px; }
    .module-title :global(.module-name) { --trace-size: clamp(1.6rem, 7vw, 2.4rem); }
    /* Phones get the picture above the text. */
    .module-window { order: -1; aspect-ratio: 16 / 10; --c: 12px; }
    .module-art { inset: 0; }
    .has-diagram .module-art { padding: 0; }
    .module-art :global(.diagram) { display: none; }
    .module-chip { display: flex; }
    .hole { width: 12px; height: 12px; border-width: 2.5px; }
    .hole-a { top: 14px; left: 24px; }
    .hole-b { top: 14px; right: 24px; }
    .hole-c { bottom: 14px; left: 24px; }
    .hole-d { bottom: 14px; right: 24px; }
    .module-ref { right: 46px; bottom: 11px; }
    .bites { width: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-bus-fill, .rail-signal { transition: none; }
  }

  /* Short, wide screens: the text and the window sit side by side, so the picture keeps its height. */
  @media (max-height: 760px) and (min-width: 1024px) {
    .rail { --card-h: clamp(420px, calc(100dvh - var(--nav-h) - 190px), 560px); }
    .rail-view { padding-block: 22px; }
    .module-tags { display: none; }
    .module { grid-template-rows: minmax(0, 1fr); grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); padding-block: 34px; gap: clamp(22px, 2.6vw, 36px); }
    .module-head { grid-template-columns: minmax(0, 1fr); align-content: start; gap: 16px; }
    .module-title { gap: 10px; }
    .module-title :global(.module-name) { --trace-size: clamp(1.4rem, 2.3vw, 2.1rem); }
    .module-summary { font-size: 1rem; }
  }
</style>
