---
import type { BoardColour, Sequence } from '../content';
import { boardStyle } from '../lib/boards';

interface Props {
  sequence: Sequence;
  /** The project's board, so the stage keeps its dark colours on the light reading layer. */
  board: BoardColour;
}

const { sequence, board } = Astro.props;
const last = String(sequence.frames).padStart(3, '0');
---

<div class="seq" style={boardStyle(board)} data-seq data-src={sequence.src} data-frames={sequence.frames}>
  <div class="seq-track" data-seq-track>
    <div class="seq-stage" data-seq-stage>
      <div class="seq-frame">
        {/* Readers without animation get the finished last frame. */}
        <img
          class="seq-still"
          src={`${sequence.src}1280/${last}.webp`}
          srcset={`${sequence.src}720/${last}.webp 720w, ${sequence.src}1280/${last}.webp 1280w`}
          sizes="(min-width: 1024px) 860px, 92vw"
          width="1280"
          height="720"
          alt={sequence.alt}
          loading="lazy"
          decoding="async"
        />
        <canvas aria-hidden="true"></canvas>
      </div>
      <ol class="seq-steps">
        {sequence.steps.map((step) => (
          <li data-seq-step data-from={step.from} data-to={step.to}>
            <span class="seq-label">{step.label}</span>
            <span class="ref">{step.detail}</span>
            <i aria-hidden="true"></i>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <p class="seq-note">{sequence.note}</p>
</div>

<style>
  .seq { margin-top: clamp(28px, 3.4vw, 44px); }
  .seq-stage {
    display: grid;
    gap: 18px;
    padding: clamp(14px, 2vw, 24px);
    background: var(--void);
    color: var(--silk);
    --c: 16px;
    clip-path: polygon(var(--c) 0, calc(100% - var(--c)) 0, 100% var(--c), 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, var(--c) 100%, 0 calc(100% - var(--c)), 0 var(--c));
  }
  /* The frames have transparent backgrounds, so the board's dot grid shows behind the parts. */
  .seq-frame {
    position: relative;
    width: min(100%, calc((100dvh - var(--nav-h) - 230px) * 16 / 9));
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    background: radial-gradient(circle, color-mix(in srgb, var(--cu) 45%, transparent) 1px, transparent 1.6px) 0 0 / 18px 18px;
  }
  .seq-frame img,
  .seq-frame canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .seq-frame canvas { display: none; }

  .seq-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .seq-steps li { display: grid; align-content: start; gap: 2px; min-width: 0; }
  .seq-label { font-size: 0.9375rem; font-weight: 700; line-height: 1.3; }
  .seq-steps .ref { color: var(--silk-dim); }
  /* Each part's own print progress, filled from the left as it prints. */
  .seq-steps i { height: 2px; margin-top: 8px; background: linear-gradient(var(--trace), var(--trace)) 0 0 / calc(var(--p, 1) * 100%) 100% no-repeat, color-mix(in srgb, var(--silk) 18%, transparent); }
  .seq-note { margin: 10px 0 0; color: var(--ink-dim); font-size: 0.875rem; line-height: 1.4; }

  /* Live: the stage holds still while the reader scrolls through the print. */
  .seq.is-live .seq-track { height: 250vh; }
  /* Roughly centred in the space under the nav; the script reads this offset back to time the scrub. */
  .seq.is-live .seq-stage { position: sticky; top: max(calc(var(--nav-h) + 20px), calc(50dvh + var(--nav-h) / 2 - 290px)); }
  .seq.is-live .seq-frame canvas { display: block; }
  /* Kept for screen readers, which still read its alt text. */
  .seq.is-live .seq-still { opacity: 0; }
  .seq.is-live [data-state='queued'] .seq-label { color: var(--silk-dim); }
  .seq.is-live [data-state='printing'] .seq-label { color: var(--trace); }

  @media (max-width: 620px) {
    .seq.is-live .seq-track { height: 210vh; }
    .seq-steps { gap: 10px; }
    .seq-label { font-size: 0.8125rem; }
    .seq-steps .ref { font-size: 0.75rem; }
  }
</style>
