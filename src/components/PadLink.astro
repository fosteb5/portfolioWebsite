---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'solid' | 'ghost';
}

const { variant = 'solid', class: className, ...rest } = Astro.props;
---

<a class:list={['pad', variant === 'ghost' && 'pad-ghost', className]} data-magnetic {...rest}><slot /></a>
